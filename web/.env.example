# Where the FastAPI backend lives. The frontend is browser-side and will
# call this URL directly. In production the proxy terminates TLS and the
# two apps share an origin, so this can be left blank.
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Production: Replace with your Railway backend URL
# NEXT_PUBLIC_API_BASE=https://securecorp-api.up.railway.app
