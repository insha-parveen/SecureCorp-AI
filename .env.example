# SecureCorp AI — environment configuration template
# Copy to .env and fill in values. Never commit .env.

# --- Paths ---
HYBRIDRAG_DATA_DIR=data
HYBRIDRAG_RAW_DIR=data/raw
HYBRIDRAG_PROCESSED_DIR=data/processed
HYBRIDRAG_CHROMA_DIR=data/chroma_db

# --- Embedding / reranking models (configurable, per CLAUDE.md) ---
HYBRIDRAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HYBRIDRAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2

# --- Dense index / embedding behaviour ---
HYBRIDRAG_CHROMA_COLLECTION=nexacore_chunks
HYBRIDRAG_EMBEDDING_BATCH_SIZE=32
HYBRIDRAG_EMBEDDING_NORMALIZE=true
# Leave unset to auto-select (cuda when available, else cpu): cpu | cuda | mps
# HYBRIDRAG_EMBEDDING_DEVICE=cpu
# Asymmetric models only (e5/bge). Empty for the MiniLM baseline.
HYBRIDRAG_EMBEDDING_DOCUMENT_PREFIX=
HYBRIDRAG_EMBEDDING_QUERY_PREFIX=

# --- Retrieval parameters ---
HYBRIDRAG_BM25_TOP_N=50
# Okapi BM25 term-frequency saturation and length normalization.
HYBRIDRAG_BM25_K1=1.5
HYBRIDRAG_BM25_B=0.75
HYBRIDRAG_DENSE_TOP_N=50
HYBRIDRAG_RRF_K=60
HYBRIDRAG_RERANK_CANDIDATES=30
HYBRIDRAG_FINAL_TOP_K=5

# --- Chunking parameters ---
# Counted with the embedding model's own tokenizer. The startup validator
# rejects any config where OVERLAP + MAX exceeds EMBEDDING_MAX_TOKENS - 2,
# because oversized chunks are silently truncated at encode time.
HYBRIDRAG_EMBEDDING_MAX_TOKENS=512
HYBRIDRAG_CHUNK_TARGET_TOKENS=440
HYBRIDRAG_CHUNK_MAX_TOKENS=440
HYBRIDRAG_CHUNK_OVERLAP_TOKENS=60
# Heading boundaries below this size merge instead of ending a chunk.
HYBRIDRAG_CHUNK_MIN_TOKENS=300

# --- Corpus versioning (bump when the raw corpus or chunking changes) ---
HYBRIDRAG_CORPUS_VERSION=2026-08-corpus-v2

# --- LLM providers (Phase 4+; leave empty for now) ---
HYBRIDRAG_LLM_MODEL=llama3
HYBRIDRAG_OLLAMA_BASE_URL=http://localhost:11434
HYBRIDRAG_GROQ_API_KEY=
HYBRIDRAG_OPENAI_API_KEY=

# --- Database (Phase 6) ---
# Local: postgresql://nexacore_admin:nexacore_password@localhost:5432/nexacore_db
HYBRIDRAG_DATABASE_URL=postgresql://nexacore_admin:nexacore_password@localhost:5432/nexacore_db

# --- Cache (Phase 7) ---
HYBRIDRAG_REDIS_URL=redis://localhost:6379/0
HYBRIDRAG_CACHE_TTL=3600
HYBRIDRAG_SEMANTIC_CACHE_THRESHOLD=0.95

